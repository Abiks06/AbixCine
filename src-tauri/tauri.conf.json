{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AbixCine",
  "version": "1.2.1",
  "identifier": "app.abixcine.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AbixCine",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#06070b",
        "center": true,
        "label": "main",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://image.tmdb.org https://s4.anilist.co https: http:",
        "media-src": "'self' blob: asset: http://asset.localhost https: http:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost https: http:",
        "worker-src": "'self' blob:",
        "frame-src": "https: http:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "AbixCine"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "AbixCine",
    "copyright": "© 2026 Ayomide Abikoye",
    "category": "Video",
    "shortDescription": "Movies, series and anime in one cinematic player",
    "longDescription": "AbixCine finds the fastest server for any movie, series or anime, with sub/dub switching, subtitles and Anime4K picture enhancement.",
    "homepage": "https://github.com/Abiks06/AbixCine"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RDkyRjM1MEZGM0M2NTgKUldSWXh2TVBOUy9aR0ppNFRnQVdsUkJNU0FldmFiSmp2RVZCVHdBNHZmRHlCcmoyYWtaWXVjS2sK",
      "endpoints": [
        "https://github.com/Abiks06/AbixCine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
